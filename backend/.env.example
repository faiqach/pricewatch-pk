# App
APP_NAME=PriceWatch PK
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/pricewatch_pk

# JWT
SECRET_KEY=your-secret-key-minimum-32-characters-long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# bcrypt
BCRYPT_SALT_ROUNDS=12

# OpenRouter AI API
OPENROUTER_API_KEY=sk-or-v1-your-key-here
AI_DEFAULT_MODEL=google/gemini-flash-1.5
AI_FALLBACK_MODEL=x-ai/grok-beta

# Scraping
SCRAPER_RUN_TIME=06:00
SCRAPER_RETRY_ATTEMPTS=3
SCRAPER_RETRY_DELAY_MINUTES=10

# OCR
TESSERACT_CMD=/usr/bin/tesseract
OCR_TEMP_DIR=./temp/ocr

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Anomaly Detection
ANOMALY_THRESHOLD_PERCENT=15.0
ZSCORE_THRESHOLD=2.0

# Portal URLs
BAHAWALNAGAR_PORTAL_URL=
LAHORE_PORTAL_URL=
MULTAN_PORTAL_URL=
BAHAWALPUR_PORTAL_URL=
ISLAMABAD_PORTAL_URL=
